# Python bytecode cache folders created automatically by the interpreter.
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv
venv/

# Input data should not be versioned.
data/input/
# Generated outputs should not be versioned.
data/output/
# Ignore everything under worldcover by default.
data/worldcover/*
# Re-include the preprocessed folder itself.
!data/worldcover/preprocessed/
# Re-include preprocessed WorldCover GeoTIFF tiles for sharing.
!data/worldcover/preprocessed/*.tif

# Ignore GeoTIFF files globally by default.
*.tif
# Ignore alternate GeoTIFF extension globally by default.
*.tiff
# Ignore Sentinel SAFE packages.
*.SAFE
# Override global GeoTIFF ignore for committed preprocessed tiles.
!data/worldcover/preprocessed/*.tif

# macOS Finder metadata files.
.DS_Store
# Windows Explorer metadata files.
Thumbs.db

# VS Code workspace settings.
.vscode/
# JetBrains IDE project settings.
.idea/
